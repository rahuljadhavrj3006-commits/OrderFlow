{
  "Urls": "http://localhost:5102",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "ServiceAuth": {
    "ApiKey": "dev-secret-key-change-me"
  },
  "Services": {
    "Inventory": {
      "BaseUrl": "http://localhost:5101"
    }
  },
  "Resilience": {
    "MaxRetries": 3,
    "BaseDelayMs": 200,
    "TimeoutSeconds": 2,
    "FailureThreshold": 5,
    "BreakDurationSeconds": 15
  },
  "AllowedHosts": "*"
}
